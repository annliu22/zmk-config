#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
        // ---------------------------
        // |  L  | SHIFT |  B  |  E  |
        // |  Z  |  OPT  |  [  |  ]  |
        // |  V  |   C   |  X  |  D  |
        // |     |       |  S  | CMD |
        // ---------------------------
        // https://www.reddit.com/r/ProCreate/comments/1it19t6/procreate_keyboard_shortcuts/
            
            bindings = <
                &mo 1  &kp Z &kp B     &kp E
                &kp LSHFT  &kp LALT  &kp LBKT  &kp RBKT
                &kp V  &kp C     &kp X     &kp D
                                &kp S     &kp LCMD
            >;
        };

        bt_layer { // Layer 1
            
        // ----------------------------------------------
        // |      &trans      |       B       |       C      |
        // |    &trans   |    &trans     |     &trans   |
            
            bindings = <
                &trans  &bt BT_CLR  &bt BT_NXT     &bt BT_PRV
                &none   &none       &none       &none
                &none   &none       &none       &none
                                    &bt BT_CLR_ALL       &kp L
            >;
        };
    };
};